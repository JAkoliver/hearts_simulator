# ====================================================================
# Build Tree (CMake & Visual Studio)
# ====================================================================
# This catches the entire build/ folder containing your CMakeCache.txt, 
# CMakeFiles, .sln, and .vcxproj files so your local compilation is ignored.
build/

# ====================================================================
# Heavy Dependencies
# ====================================================================
# Prevents the multi-gigabyte C++ LibTorch library from hitting Git.
libtorch/
libtorch-cpu/
libtorch-cuda.zip

# ====================================================================
# Machine Learning Weights & Serialized Models
# ====================================================================
# Catches hearts_model_final.pth, hearts_model_interrupted.pth,
# and the compiled TorchScript graph hearts_ai_grandmaster.pt.
*.pt
*.pth

# ====================================================================
# Compiled C++ Extensions & Binaries
# ====================================================================
# Catches the compiled Python C++ module (hearts_env.cp311-win_amd64.pyd)
# as well as any loose executables or dynamic libraries.
*.pyd
*.exe
*.dll
*.pdb
*.ilk

# ====================================================================
# Python Caches & Environments
# ====================================================================
__pycache__/
*.pyc
.venv/
venv/

# ====================================================================
# User-Specific IDE Configurations
# ====================================================================
.vscode/
.idea/
*.suo
*.user
# Regenerable search evaluation outputs
search_eval_*.csv

# Expert-iteration artifacts
selfplay_data/
*.bin
hearts_model_candidate.pth
train_last_run.log
hearts_match_log.csv

# MCP config carries the RunPod API key - never commit
.mcp.json

# AOTI packages are per-arch build artifacts
*.pt2
cloud_jobs/
hearts_web/site_config.py
hearts_web/static/models/
hearts_web/static/ort/
hearts_web/.share_secret
hearts_web/player_names.jsonl
hearts_web/player_keys.jsonl

# ====================================================================
# Live-site operations & player data (release boundary: never public,
# see docs/RELEASE_PLAN.md sec. 2/6 and docs/site_security_design.md)
# ====================================================================
hearts_web/match_logs.jsonl
logs/
# Tunnel infrastructure + machine-specific schedule launchers
RUN_TUNNEL.cmd
TUNNEL_HELPER.ps1
# Live site origin address (the thing the tunnel exists to conceal)
ops/deploy_target.env
MORNING_TO_GENTLE.cmd
PAUSE_V2_EXPERIMENT.cmd
RESUME_V2_EXPERIMENT.cmd
RUN_FAST_GEN_NIGHT.cmd
STOP_GEN_*.cmd
# Local WASM/node build tree (regenerable)
node_build/

# B2 training banks: regenerable from the A2 corpus (seeded builder)
b2_data/

hearts_web/daily_attempts.jsonl

hearts_web/tables_snapshot.pkl*
hearts_web/search_uploads.jsonl
hearts_web/progress_stats.jsonl
hearts_web/supporters.json
moon images/

# NVIDIA-licensed CUDA runtime headers: fetched locally, never tracked
# (scripts/fetch_cuda_headers.py; RELEASE_PLAN sec. 4.3)
third_party/cuda_include/
.v6_queue_token
hearts_web/review_cache/

# session onboarding doc: machine-local, mirrored in the ops repo, NEVER tracked
CLAUDE.md

# ---- research artifacts: derived, huge, regenerable from seeds ----
# Rationale: 7.6 GB of these sat untracked-and-unignored, so a single
# `git add -A` would try to commit the whole v6 training bank (audit
# 2026-08-13). The reproducibility contract is (seed, chunk) -> data,
# so banks and trial checkpoints are regenerable, not archival.
# NOTE the deliberate exceptions below: verdict JSONs and the N=8000
# validation dataset ARE evidence cited in docs and stay committable.
expert_data/
v6_stage3/
v6_stage4/
probe_decisions_*.csv
behave_*.csv
se_*.csv
*.npz
equity_data/expert_iter_v2/
equity_data/exploiter_r1/
equity_data/exploiter_r2/
equity_data/instrument_check/
!equity_data/verdicts/**
!equity_data/validation_v1/**

# player-submitted feedback (may contain a volunteered email)
hearts_web/feedback.jsonl
hearts_web/match_logs.jsonl.*

# release-asset staging (weights go to GitHub Releases, never tracked)
release_staging/


equity_data/exploiter_r11/gate/*.done
equity_data/exploiter_r11/gate_ref/*.tricks.csv
equity_data/exploiter_r11/gate_ref/*.log
equity_data/exploiter_r11/gate_ref/*.done
equity_data/exploiter_r11/gate_ref/driver.log
equity_data/exploiter_r11/gate/driver.log
equity_data/exploiter_r11/gate_driver.out
equity_data/exploiter_r11/*_u[0-9].log
equity_data/exploiter_r11/vecprobe_*.log
